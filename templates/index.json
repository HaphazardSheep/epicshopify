    "sco_visuals": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign visual_count = 0 %}\n<section class=\"sco-section sco-lookbook-section\" aria-labelledby=\"sco-lookbook-title\">\n  <div class=\"sco-section__heading\">\n    <div>\n      <p class=\"sco-eyebrow\">02 / THE SHELF</p>\n      <h2 id=\"sco-lookbook-title\">GOOD PRODUCTS DESERVE A GOOD CLOSE-UP.</h2>\n    </div>\n    <p class=\"sco-section__aside\">Real products. Real photography. One click from discovery to product page.</p>\n  </div>\n  <div class=\"sco-lookbook\">\n    {% for product in collections.all.products limit: 4 %}\n      {% if product.featured_image %}\n        {% assign visual_count = visual_count | plus: 1 %}\n        <a class=\"sco-lookbook__card sco-lookbook__card--{{ visual_count }}\" href=\"{{ product.url }}\">\n          <img\n            src=\"{{ product.featured_image | image_url: width: 1200 }}\"\n            alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n            loading=\"lazy\"\n            width=\"1200\"\n            height=\"1500\"\n          >\n          <div class=\"sco-lookbook__overlay\">\n            <span>{{ product.vendor | default: 'SPECTRAL & CO' | escape }}</span>\n            <strong>{{ product.title | escape }}</strong>\n            <small>VIEW PRODUCT →</small>\n          </div>\n        </a>\n      {% endif %}\n    {% endfor %}\n    {% if visual_count == 0 %}\n      <a class=\"sco-lookbook__empty\" href=\"{{ routes.all_products_collection_url }}\">\n        <span>YOUR PRODUCT PHOTOGRAPHY WILL LIVE HERE</span>\n        <strong>BUILD THE SHELF →</strong>\n        <small>Add products to the store and this section automatically turns into a clickable beauty lookbook.</small>\n      </a>\n    {% endif %}\n  </div>\n</section>",
