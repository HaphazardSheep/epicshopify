    "sco_subscribe": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section id=\"sco-subscribe\" class=\"sco-subscribe\" aria-labelledby=\"sco-subscribe-title\">\n  <div class=\"sco-subscribe__inner\">\n    <div class=\"sco-subscribe__copy\">\n      <p class=\"sco-eyebrow\">03 / THE RITUAL</p>\n      <h2 id=\"sco-subscribe-title\">RUN OUT OF BEAUTY?<br><em>DON’T.</em></h2>\n      <p>Turn the products you actually use into a recurring ritual. Subscribe, save, and keep your everyday essentials on autopilot.</p>\n      <div class=\"sco-subscribe__perks\">\n        <span>✦ Flexible cadence</span>\n        <span>✦ Skip or cancel</span>\n        <span>✦ Less re-ordering</span>\n      </div>\n      <a class=\"sco-btn sco-btn--light\" href=\"{{ routes.all_products_collection_url }}\">SHOP SUBSCRIPTION-READY PRODUCTS</a>\n    </div>\n    <div class=\"sco-subscribe__cards\">\n      {% assign subscription_count = 0 %}\n      {% for product in collections.all.products limit: 12 %}\n        {% if product.selling_plan_groups.size > 0 %}\n          {% assign subscription_count = subscription_count | plus: 1 %}\n          <a class=\"sco-subscribe__card\" href=\"{{ product.url }}\">\n            {% if product.featured_image %}\n              <img src=\"{{ product.featured_image | image_url: width: 700 }}\" alt=\"{{ product.featured_image.alt | default: product.title | escape }}\" loading=\"lazy\" width=\"700\" height=\"875\">\n            {% endif %}\n            <div>\n              <small>{{ product.selling_plan_groups.first.name | escape }}</small>\n              <strong>{{ product.title | escape }}</strong>\n              <span>{{ product.price | money }} · SHOP &amp; SUBSCRIBE →</span>\n            </div>\n          </a>\n        {% endif %}\n      {% endfor %}\n      {% if subscription_count == 0 %}\n        <div class=\"sco-subscribe__setup\">\n          <span>SUBSCRIBE &amp; SAVE</span>\n          <strong>Make your everyday favorites automatic.</strong>\n          <p>Once subscription plans are attached to products, they’ll appear here automatically and the product pages can offer recurring purchase options.</p>\n          <a href=\"{{ routes.all_products_collection_url }}\">BROWSE THE EDIT →</a>\n        </div>\n      {% endif %}\n    </div>\n  </div>\n</section>",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
