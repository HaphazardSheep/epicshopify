    "sco_routine": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"sco-section sco-routine-section\" aria-labelledby=\"sco-routine-title\">\n  <div class=\"sco-section__heading\">\n    <div>\n      <p class=\"sco-eyebrow\">04 / WHY SPECTRAL &amp; CO</p>\n      <h2 id=\"sco-routine-title\">A BEAUTY SHOP THAT GETS OUT OF YOUR WAY.</h2>\n    </div>\n    <a class=\"sco-text-link\" href=\"{{ routes.cart_url }}\">GO TO CART →</a>\n  </div>\n  <div class=\"sco-routine\">\n    <div class=\"sco-routine__copy\">\n      <p>Big imagery. Clear choices. Quick add. A cart that stays close by. Everything is designed to help you find the right product and move on with your day.</p>\n      <div class=\"sco-routine__links\">\n        <a href=\"{{ routes.all_products_collection_url }}\">SHOP ALL</a>\n        <a href=\"{{ routes.search_url }}\">SEARCH</a>\n        <a href=\"{{ routes.cart_url }}\">CART</a>\n      </div>\n    </div>\n    <div class=\"sco-routine__list\">\n      <a class=\"sco-routine__item\" href=\"{{ routes.all_products_collection_url }}\"><strong>01</strong><span>Clean, high-impact product presentation</span><b>→</b></a>\n      <a class=\"sco-routine__item\" href=\"/collections/all?sort_by=best-selling\"><strong>02</strong><span>Customer favorites, surfaced fast</span><b>→</b></a>\n      <a class=\"sco-routine__item\" href=\"/collections/all?sort_by=created-descending\"><strong>03</strong><span>Newness without the hunt</span><b>→</b></a>\n      <a class=\"sco-routine__item\" href=\"#sco-subscribe\"><strong>04</strong><span>Recurring beauty, when you want it</span><b>→</b></a>\n    </div>\n  </div>\n  <div class=\"sco-social-strip\"><div><strong>YOUR NEXT FAVORITE MIGHT BE ONE CLICK AWAY.</strong><span>Browse the edit, save your favorites, and keep your routine moving.</span></div><a class=\"sco-btn sco-btn--secondary\" href=\"{{ routes.all_products_collection_url }}\">SHOP NOW</a></div>\n</section>",
