    "sco_hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign hero_product = collections.all.products.first %}\n<section class=\"sco-hero\" aria-labelledby=\"sco-hero-title\">\n  <div class=\"sco-hero__inner\">\n    <div class=\"sco-hero__copy\">\n      <p class=\"sco-kicker\">SPECTRAL &amp; CO / THE BEAUTY EDIT</p>\n      <h1 id=\"sco-hero-title\">BEAUTY, <em>CURATED.</em></h1>\n      <p class=\"sco-hero__lede\">The good stuff, without the endless scrolling. Discover a considered edit of beauty made for everyday rituals, little luxuries, and everything in between.</p>\n      <div class=\"sco-hero__actions\">\n        <a class=\"sco-btn sco-btn--primary\" href=\"{{ routes.all_products_collection_url }}\">EXPLORE THE EDIT</a>\n        <a class=\"sco-btn sco-btn--secondary\" href=\"{{ routes.search_url }}\">SEARCH BEAUTY</a>\n      </div>\n      <div class=\"sco-hero__details\">\n        <div class=\"sco-hero__detail\"><strong>EDITED</strong><span>Less noise. Better finds.</span></div>\n        <div class=\"sco-hero__detail\"><strong>BEAUTIFUL</strong><span>Designed to look as good as it feels.</span></div>\n        <div class=\"sco-hero__detail\"><strong>SIMPLE</strong><span>Quick shopping from browse to checkout.</span></div>\n      </div>\n    </div>\n    <div class=\"sco-hero__visual\">\n      <div class=\"sco-hero__orb sco-hero__orb--one\"></div>\n      <div class=\"sco-hero__orb sco-hero__orb--two\"></div>\n      {% if hero_product and hero_product.featured_image %}\n        <a class=\"sco-hero__product\" href=\"{{ hero_product.url }}\" aria-label=\"Shop {{ hero_product.title | escape }}\">\n          <img src=\"{{ hero_product.featured_image | image_url: width: 1100 }}\" alt=\"{{ hero_product.featured_image.alt | default: hero_product.title | escape }}\" loading=\"eager\" width=\"1100\" height=\"1375\">\n          <span>FEATURED FIND · SHOP →</span>\n        </a>\n      {% endif %}\n      <span class=\"sco-hero__stamp\">THE NEW OBSESSION<br><small>BEAUTY / DAILY</small></span>\n    </div>\n  </div>\n</section>",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "sco_discover": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign mood1 = collections.all.products[0] %}{% assign mood2 = collections.all.products[1] %}{% assign mood3 = collections.all.products[2] %}{% assign mood4 = collections.all.products[3] %}\n<section class=\"sco-section sco-moods\" aria-labelledby=\"sco-discover-title\">\n  <div class=\"sco-section__heading\">\n    <div><p class=\"sco-eyebrow\">01 / SHOP THE MOOD</p><h2 id=\"sco-discover-title\">WHAT ARE WE INTO<br><em>RIGHT NOW?</em></h2></div>\n    <a class=\"sco-text-link\" href=\"{{ routes.all_products_collection_url }}\">VIEW EVERYTHING →</a>\n  </div>\n  <div class=\"sco-mood-grid\">\n    <a class=\"sco-mood-card sco-mood-card--tall\" href=\"{{ routes.search_url }}?q=skincare\"{% if mood1.featured_image %} style=\"--mood-image: url('{{ mood1.featured_image | image_url: width: 1200 }}')\"{% endif %}>\n      <span>01 / SKIN</span><strong>Reset.<br>Replenish.<br>Glow.</strong><small>Shop skincare →</small>\n    </a>\n    <a class=\"sco-mood-card\" href=\"{{ routes.search_url }}?q=makeup\"{% if mood2.featured_image %} style=\"--mood-image: url('{{ mood2.featured_image | image_url: width: 900 }}')\"{% endif %}>\n      <span>02 / MAKEUP</span><strong>A little<br>more.</strong><small>Shop makeup →</small>\n    </a>\n    <a class=\"sco-mood-card sco-mood-card--dark\" href=\"/collections/all?sort_by=best-selling\"{% if mood3.featured_image %} style=\"--mood-image: url('{{ mood3.featured_image | image_url: width: 900 }}')\"{% endif %}>\n      <span>03 / THE EDIT</span><strong>Customer<br>favorites.</strong><small>See bestsellers →</small>\n    </a>\n    <a class=\"sco-mood-card\" href=\"/collections/all?sort_by=created-descending\"{% if mood4.featured_image %} style=\"--mood-image: url('{{ mood4.featured_image | image_url: width: 900 }}')\"{% endif %}>\n      <span>04 / JUST IN</span><strong>Newness,<br>right this way.</strong><small>Shop new in →</small>\n    </a>\n  </div>\n</section>",
