    "kynza_product_story": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"kynza-product-story\" aria-label=\"More about {{ product.title | escape }}\">\n  <div class=\"kynza-product-story__inner\">\n    <div class=\"kynza-product-story__image\">\n      {% if product.images.size > 1 %}\n        {{ product.images[1] | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(max-width: 749px) 100vw, 50vw', alt: product.images[1].alt | default: product.title | escape }}\n      {% elsif product.featured_image %}\n        {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(max-width: 749px) 100vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}\n      {% endif %}\n      <span>02 / ANOTHER LOOK</span>\n    </div>\n    <div class=\"kynza-product-story__copy\">\n      <p class=\"sco-eyebrow\">KYNZA / THE PRODUCT EDIT</p>\n      <h2>THE DETAILS<br><em>MATTER.</em></h2>\n      <p>{{ product.description | strip_html | truncatewords: 55 }}</p>\n      <div class=\"kynza-product-story__meta\">\n        <span>{% if product.vendor != blank %}{{ product.vendor | escape }}{% else %}KYNZA EDIT{% endif %}</span>\n        <span>{% if product.type != blank %}{{ product.type | escape }}{% else %}BEAUTY{% endif %}</span>\n      </div>\n      <a class=\"sco-btn sco-btn--primary\" href=\"{{ routes.all_products_collection_url }}\">BACK TO THE SHELF</a>\n    </div>\n  </div>\n</section>",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
